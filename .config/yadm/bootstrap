#!/usr/bin/env bash
echo "Bootstrapping..."
declare -A linux_types 

if [ -e /etc/os-release ] ; then 
  source /etc/os-release
fi

function install_redhat_like() {
  echo "Doing redhat like install"
}

function install_debian_like() {
  echo "Installing ubuntu like"
}

echo "id: $ID" 
case "$ID" in 
  "almalinux" |"redhat" )
    install_redhat_like ;;
  "Ubuntu")
    install_debian_like ;;
  *)
  echo "Unable to determin install type"
esac



