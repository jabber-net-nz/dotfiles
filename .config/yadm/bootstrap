#!/usr/bin/env bash
echo "Bootstrapping..."
declare -A linux_types 

if [ -e /etc/os-release ] ; then 
  source /etc/os-release
fi

function install_redhat_like() {
  sudo yum install -y vim tmux 
  # install starship
  curl -sS https://starship.rs/install.sh | sh -s -- -f --bin-dir $HOME/bin
  # install tmux plugin manager
  git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
  # install direnv - critical 
  bin_path=$HOME/bin
  curl -sfL https://direnv.net/install.sh | bash
  # eget 
  curl -o eget.sh https://zyedidia.github.io/eget.sh
  bash eget.sh
  mv ./eget ~/bin
  # now we have eget, lets install some other bits we'll likely need
  ~/bin/eget --to=~/bin junegunn/fzf
  echo "Doing redhat like install"
  source ~/.bashrc
}

function install_debian_like() {
  echo "Installing ubuntu like"
  sudo apt-get install tmux tmux-plugin-manager eza
}

echo "id: $ID" 
case "$ID" in 
  "almalinux" |"redhat" | "rhel" )
    install_redhat_like ;;
  "Ubuntu" | "ubuntu" )
    install_debian_like ;;
  *)
  echo "Unable to determin install type for $ID"
esac



